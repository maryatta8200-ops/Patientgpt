{
  "name": "pulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pulse — a premium local-first PWA with a burn-after-read Google Sheets relay.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit false --pretty",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --experimental-strip-types tests/followup.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
